  {
    "name": "Category",
    "ref": "com.adobe.captivateprime.category",
    "widgetRef": "learning/components/category",
    "description": "Use this widget to display learning content from Catalogs, Products or Roles as categories.",
    "type": "widget",
    "options": [
      {
        "name": "Widget title",
        "ref": "widgetConfig.attributes.title",
        "description": "",
        "type": "string",
        "default": "",
        "mandatory": true
      },
      {
        "name": "Widget description",
        "ref": "widgetConfig.attributes.description",
        "description": "",
        "type": "string",
        "default": "",
        "mandatory": false
      },
      {
        "name": "Display category image",
        "ref": "widgetConfig.attributes.showImage",
        "description": "",
        "type": "boolean",
        "default": false,
        "mandatory": false
      },
      {
        "name": "Display category description",
        "ref": "widgetConfig.attributes.showDescription",
        "description": "",
        "type": "boolean",
        "default": false,
        "mandatory": false
      },
      {
        "name": "Category source",
        "ref": "widgetConfig.attributes.source",
        "description": "Type of category to display",
        "type": "select",
        "options": [
          {
            "label": "nomenclature.CATALOG.plural",
            "value": "CATALOGS"
          },
          {
            "label": "nomenclature.PRODUCT.plural",
            "value": "PRODUCTS",
            "requiresFeature": "prlProductsEnabled"
          },
          {
            "label": "nomenclature.ROLE.plural",
            "value": "ROLES",
            "requiresFeature": "prlRolesEnabled"
          }
        ],
        "default": "CATALOGS",
        "mandatory": true
      },
      {
        "name": "Selection mode",
        "ref": "widgetConfig.attributes.selectionMode",
        "description": "",
        "type": "radio",
        "options": [
          {
            "label": "All",
            "value": "all"
          },
          {
            "label": "Select",
            "value": "select"
          }
        ],
        "default": "all",
        "_comment": "JavaScript dynamically updates labels based on source (e.g., 'All Catalogs', 'Select Catalogs')",
        "mandatory": false
      },
      {
        "name": "Selected items",
        "ref": "widgetConfig.attributes.sourceIds",
        "description": "",
        "type": "autocomplete",
        "dataSource": "category",
        "emptyText": "Select items (up to 25)",
        "_comment": "JavaScript dynamically updates labels, placeholder, and datasource based on source",
        "multiSelect": true,
        "mandatory": false
      }
    ]
  },
  {
    "name": "nomenclature.COURSE.plural & nomenclature.PATH.plural",
    "ref": "com.adobe.captivateprime.courses.and.paths",
    "widgetRef": "learning/components/coursesAndPaths",
    "description": "Display selected courses and learning paths",
    "type": "widget",
    "options": [
      {
        "name": "Widget title",
        "ref": "widgetConfig.attributes.title",
        "description": "",
        "type": "string",
        "default": "",
