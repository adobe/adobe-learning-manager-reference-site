      },
      {
        "name": "Widget description",
        "ref": "widgetConfig.attributes.description",
        "description": "",
        "type": "string",
        "default": "",
        "mandatory": false
      },
      {
        "name": "nomenclature.COURSE.plural & nomenclature.PATH.plural to be shown in the widget",
        "ref": "widgetConfig.attributes.isSourceSelected",
        "description": "Choose how to select courses and paths",
        "type": "radio",
        "options": [
          {
            "label": "Select source",
            "value": "true"
          },
          {
            "label": "Add manually (up to 25)",
            "value": "false"
          }
        ],
        "default": "true",
        "mandatory": true
      },
      {
        "name": "Source",
        "ref": "widgetConfig.attributes.coursesAndPaths.source",
        "description": "Type of source to display",
        "type": "select",
        "options": [
          {
            "label": "nomenclature.CATALOG.plural",
            "value": "CATALOGS"
          },
          {
            "label": "nomenclature.PRODUCT.plural",
            "value": "PRODUCTS",
            "requiresFeature": "prlProductsEnabled"
          },
          {
            "label": "nomenclature.ROLE.plural",
            "value": "ROLES",
            "requiresFeature": "prlRolesEnabled"
          },
          {
            "label": "nomenclature.SKILL.plural",
            "value": "SKILLS"
          }
        ],
        "default": "CATALOGS",
        "mandatory": false
      },
      {
        "name": "Source details",
        "ref": "widgetConfig.attributes.sourceDetails",
        "description": "Select one or more source items. Roles, products and skills whose name contains a comma cannot be selected.",
        "type": "autocomplete",
        "dataSource": "coursesandpaths-source",
        "emptyText": "Select items",
        "multiSelect": true,
        "draggable": false,
        "mandatory": false
      },
      {
        "name": "Selected nomenclature.COURSE.plural & nomenclature.PATH.plural",
        "ref": "widgetConfig.attributes.loIds",
        "description": "Select courses and learning paths",
        "type": "autocomplete",
        "dataSource": "lo",
        "emptyText": "Add manually (up to 25)",
        "multiSelect": true,
        "mandatory": false
      },
      {
        "name": "Learning Object type",
        "ref": "widgetConfig.attributes.loTypes",
        "description": "Filter by learning object type",
        "type": "autocomplete",
        "dataSource": "loType",
        "emptyText": "All types",
        "multiSelect": true,
        "draggable": false,
        "mandatory": false
      }
    ]
  },
